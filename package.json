{
  "name": "resume",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest --coverage",
    "test:unit:all": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:show-report": "playwright show-report",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@unocss/reset": "^66.12.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@unocss/eslint-config": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "typescript": "~5.9.3",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
